---
/**
 * Inline SVG icon set. Keeps the site font-dependency-free (no FontAwesome).
 * Skill glyphs use stroke; brand glyphs use fill (path data from Simple Icons / feather).
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className = '' } = Astro.props;

const stroke: Record<string, string> = {
