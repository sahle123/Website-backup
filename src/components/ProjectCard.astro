---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props { project: Project; index: number; }
const { project, index } = Astro.props;
---
<article class={`card ${index === 0 ? 'card--feature' : ''}`} data-reveal data-delay={(index % 4) + 1}>
  <a class="card__link" href={`/projects/${project.slug}/`} aria-label={`View ${project.title}`}>
    <div class="card__media">
      <Image
        src={project.card}
        alt={`${project.title} — ${project.category}`}
        widths={[400, 700, 1000]}
        sizes="(min-width: 960px) 45vw, 100vw"
        loading={index < 2 ? 'eager' : 'lazy'}
        class="card__img"
      />
      {project.badge && <span class="card__badge">{project.badge}</span>}
    </div>
    <div class="card__body">
      <span class="card__cat">{project.category}</span>
      <h3 class="card__title">
        {project.title}
        <span class="card__arrow"><Icon name="arrow" size={18} /></span>
      </h3>
      <p class="card__tag">{project.tagline}</p>
      <ul class="card__tech">
        {project.technologies.slice(0, 4).map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-glass);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    transition: transform 0.35s var(--ease), border-color 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: var(--border-strong);
    box-shadow: 0 24px 50px -24px rgba(0, 0, 0, 0.7);
  }
  .card__link { display: flex; flex-direction: column; height: 100%; }

  .card__media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; }
  .card__img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .card:hover .card__img { transform: scale(1.05); }
  .card__badge {
    position: absolute;
    top: var(--space-2); left: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    color: var(--text);
    background: rgba(10, 14, 20, 0.72);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-strong);
  }

  .card__body { padding: var(--space-3); display: flex; flex-direction: column; gap: var(--space-1); flex: 1; }
  .card__cat {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card__title {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-1);
    font-size: 1.4rem;
  }
  .card__arrow {
    color: var(--text-muted);
    transform: translateX(-4px);
    opacity: 0;
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease), color 0.3s var(--ease);
  }
  .card:hover .card__arrow { opacity: 1; transform: translateX(0); color: var(--accent); }
  .card__tag { color: var(--text-muted); font-size: 0.95rem; }
  .card__tech {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
    margin-top: auto; padding-top: var(--space-2);
  }
  .card__tech li {
    font-size: 0.72rem;
    color: var(--text-faint);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.2rem 0.5rem;
  }

  /* Feature card spans full width on wide screens for an asymmetric grid */
  @media (min-width: 900px) {
    .card--feature { grid-column: span 2; }
    .card--feature .card__media { aspect-ratio: 21 / 9; }
    .card--feature .card__title { font-size: 1.7rem; }
  }
</style>
