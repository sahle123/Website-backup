---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, index },
  }));
}

const { project, index } = Astro.props;
const next = projects[(index + 1) % projects.length];
const isExternal = project.launch && project.launch.url.startsWith('http');
---
<Base title={`${project.title} — ${site.name}`} description={project.tagline}>
  <Nav base="/" />
  <main id="main" class="project">
    <div class="container">
      <a class="project__back" href="/#work" data-magnetic>
        <span aria-hidden="true">←</span> Back to work
      </a>

      <header class="project__head" data-reveal>
        <span class="eyebrow">{project.category}</span>
        <h1 class="project__title">{project.title}</h1>
        <p class="project__tag">{project.tagline}</p>
        {project.badge && <span class="project__badge">{project.badge}</span>}
      </header>

      <div class="project__hero glass" data-reveal data-delay="1">
        <Image
          src={project.gallery[0]}
          alt={`${project.title} screenshot`}
          widths={[600, 1000, 1400]}
          sizes="(min-width: 1100px) 1000px, 100vw"
          loading="eager"
          class="project__hero-img"
        />
      </div>

      <div class="project__body">
        <div class="project__desc" data-reveal>
          <h2 class="project__sub">Overview</h2>
          {project.description.map((p) => <p set:html={p} />)}

          {project.launch && (
            <a
              class="btn btn--primary project__launch"
              href={project.launch.url}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener' : undefined}
              data-magnetic
            >
              <Icon name={isExternal ? 'external' : 'play'} size={18} />
              {project.launch.label}
            </a>
          )}
        </div>

        <aside class="project__meta glass" data-reveal data-delay="1">
          <div class="project__meta-block">
            <h3>Technologies</h3>
            <ul class="project__tags">
              {project.technologies.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          {project.team && (
            <div class="project__meta-block">
              <h3>Team</h3>
              <ul class="project__team">
                {project.team.map((m) => <li>{m}</li>)}
              </ul>
            </div>
          )}
        </aside>
      </div>

      {project.gallery.length > 1 && (
        <div class="project__gallery" data-reveal>
          {project.gallery.slice(1).map((img) => (
            <div class="project__shot glass">
              <Image
                src={img}
                alt={`${project.title} additional screenshot`}
                widths={[500, 900]}
                sizes="(min-width: 720px) 45vw, 100vw"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      )}

      <a class="project__next glass" href={`/projects/${next.slug}/`} data-reveal data-magnetic>
        <span class="project__next-label">Next project</span>
        <span class="project__next-title">{next.title} <Icon name="arrow" size={20} /></span>
      </a>
    </div>
  </main>
  <Footer base="/" />
</Base>

<style>
  .project { padding-top: var(--space-5); }
  .project__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color 0.2s var(--ease);
    margin-bottom: var(--space-4);
  }
  .project__back:hover { color: var(--accent); }

  .project__head { max-width: 46rem; margin-bottom: var(--space-4); }
  .project__title { font-size: clamp(2.4rem, 7vw, 4rem); margin-block: var(--space-2) var(--space-2); }
  .project__tag { color: var(--text-muted); font-size: 1.2rem; }
  .project__badge {
    display: inline-block;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    color: var(--text);
    background: rgba(52, 226, 208, 0.1);
    border: 1px solid var(--border-strong);
  }

  .project__hero { overflow: hidden; margin-bottom: var(--space-5); }
  .project__hero-img { width: 100%; max-height: 560px; object-fit: cover; }

  .project__body {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    margin-bottom: var(--space-5);
  }
  .project__sub { font-size: 1.4rem; margin-bottom: var(--space-2); }
  .project__desc p { color: var(--text-muted); margin-bottom: var(--space-2); line-height: 1.7; }
  /* Only style inline links inside the write-up paragraphs — NOT the launch
     button, which is also an <a> directly under .project__desc. */
  .project__desc :global(p a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  /* Darker, neutral text so it reads clearly against the cyan button
     (the default teal ink sits too close in hue to the button colour). */
  .project__launch { margin-top: var(--space-2); color: #04100e; }
  .project__launch:hover { color: #04100e; }

  .project__meta { padding: var(--space-3); height: fit-content; display: flex; flex-direction: column; gap: var(--space-3); }
  .project__meta-block h3 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }
  .project__tags { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .project__tags li {
    font-size: 0.82rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
  }
  .project__team { display: flex; flex-direction: column; gap: 0.35rem; color: var(--text-muted); font-size: 0.92rem; }

  .project__gallery {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
    margin-bottom: var(--space-5);
  }
  .project__shot { overflow: hidden; }
  .project__shot :global(img) { width: 100%; object-fit: cover; }

  .project__next {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .project__next:hover { border-color: var(--accent); }
  .project__next-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .project__next-title { display: inline-flex; align-items: center; gap: var(--space-1); font-size: 1.6rem; font-weight: 700; }
  .project__next:hover .project__next-title { color: var(--accent); }

  @media (min-width: 760px) {
    .project__body { grid-template-columns: 1.6fr 1fr; gap: var(--space-5); }
    .project__gallery { grid-template-columns: repeat(2, 1fr); }
  }
</style>
